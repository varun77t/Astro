# API settings. Copy to .env and fill in; never commit .env.
# The web app's settings live in apps/web/.env.local (see apps/web/.env.example).

# --- API (apps/api) ---
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000

# --- Supabase (accounts, saved charts) ---
# The API only needs the project URL: it checks sign-in tokens against the project's public
# signing keys. The web app reads NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY from apps/web/.env.local.
SUPABASE_URL=

# --- AI-written readings ---
# Any of these; providers without a key are skipped. Without any, readings show the rule texts.
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: order to try them in, and the time budget per reading before falling back.
# LLM_PROVIDERS=gemini,gemini_35,groq,gemini_lite,gemini_lite_31
# LLM_BUDGET_SECONDS=25
# Optional per-provider overrides of apps/api/app/llm/providers.yaml, e.g.
# GEMINI_MODEL=gemini-3.5-flash
# GROQ_RPD=1000
# READINGS_CACHE_PATH=apps/api/.cache/readings.sqlite3

# --- Geocoding ---
# Photon and Nominatim ask for an identifying User-Agent with contact info.
GEOCODER_USER_AGENT="vedic-astro/0.1 (you@example.com)"
# Optional overrides
# PHOTON_URL=https://photon.komoot.io/api/
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# GEOCODE_CACHE_PATH=apps/api/.cache/geocode.sqlite3
# GEOCODE_CACHE_TTL_DAYS=30
