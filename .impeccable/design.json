  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The only button style: charcoal fill, white Geist 500, usually paired with a short red-pen note.",
      "html": "<span class=\"ds-row\"><button class=\"ds-btn\">Calculate my chart <svg width=\"16\" height=\"16\" viewBox=\"0 0 16 16\" fill=\"none\" aria-hidden=\"true\"><path d=\"M3 8h9M8.5 4.5 12 8l-3.5 3.5\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></button><span class=\"ds-pen-note\">free, about a minute</span></span>",
      "css": ".ds-row{display:inline-flex;align-items:center;gap:1.25rem;flex-wrap:wrap}.ds-btn{display:inline-flex;align-items:center;gap:.5rem;border:0;border-radius:6px;background:var(--ink,#111111);color:#fff;padding:.8rem 1.25rem;font:500 1rem var(--font-sans,Geist,'Helvetica Neue',sans-serif);cursor:pointer;transition:background-color 200ms,transform 120ms}.ds-btn:hover{background:#333}.ds-btn:active{transform:scale(.98)}.ds-btn:focus-visible{outline:2px solid var(--ink,#111111);outline-offset:3px}.ds-btn:disabled{background:var(--muted,#6b6a66);cursor:progress}.ds-pen-note{font-family:var(--font-hand,Kalam,cursive);color:var(--pen,#9f2f2d);font-size:1.125rem}"
    },
    {
      "name": "Compact Button",
      "kind": "button",
      "refersTo": "button-compact",
      "description": "Header action and inline tools.",
      "html": "<button class=\"ds-btn-sm\">Calculate my chart</button>",
      "css": ".ds-btn-sm{display:inline-flex;align-items:center;border:0;border-radius:6px;background:var(--ink,#111111);color:#fff;padding:.5rem 1rem;font:500 .875rem var(--font-sans,Geist,sans-serif);cursor:pointer;transition:background-color 200ms,transform 120ms}.ds-btn-sm:hover{background:#333}.ds-btn-sm:active{transform:scale(.98)}.ds-btn-sm:focus-visible{outline:2px solid var(--ink,#111111);outline-offset:3px}"
    },
    {
      "name": "Underline Link",
      "kind": "custom",
      "refersTo": "link",
      "description": "Secondary actions in place of a second button style.",
      "html": "<a class=\"ds-link\" href=\"#\">Back to the details</a>",
      "css": ".ds-link{color:var(--ink,#111111);text-decoration:underline;text-decoration-color:var(--rule-strong,#d9d8d4);text-underline-offset:4px;transition:text-decoration-color 200ms;font-family:var(--font-sans,Geist,sans-serif)}.ds-link:hover{text-decoration-color:var(--ink,#111111)}.ds-link:focus-visible{outline:2px solid var(--ink,#111111);outline-offset:3px;border-radius:4px}"
    },
    {
      "name": "Answer Line",
      "kind": "input",
      "refersTo": "answer-line",
      "description": "A question in serif answered on an underline; firms to ink on focus, pen red when invalid.",
      "html": "<div class=\"ds-q\"><label class=\"ds-q-title\" for=\"ds-place\">Where were you born?</label><input id=\"ds-place\" class=\"ds-answer\" placeholder=\"Start typing a town or city\"><input class=\"ds-answer\" aria-invalid=\"true\" value=\"Atlantis\" aria-label=\"Invalid example\"><p class=\"ds-err\"><svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\" aria-hidden=\"true\"><path d=\"M2.5 2.5 L11.5 11.5 M11.5 2.5 L2.5 11.5\" stroke=\"#9f2f2d\" stroke-width=\"2\" stroke-linecap=\"round\"/></svg>Pick a place from the list.</p></div>",
      "css": ".ds-q{max-width:28rem;display:grid;gap:.75rem}.ds-q-title{font-family:var(--font-serif,'Instrument Serif',serif);font-size:2.2rem;line-height:1.05;letter-spacing:-.02em;color:var(--ink,#111111)}.ds-answer{width:100%;border:0;border-bottom:1px solid var(--rule-strong,#d9d8d4);background:transparent;padding:.35rem .1rem;font-size:1.125rem;color:var(--ink,#111111);border-radius:0;outline:none;caret-color:var(--pen,#9f2f2d);transition:border-color 200ms}.ds-answer::placeholder{color:var(--muted,#6b6a66)}.ds-answer:focus{border-bottom-color:var(--ink,#111111);box-shadow:0 1px 0 0 var(--ink,#111111)}.ds-answer[aria-invalid=true]{border-bottom-color:var(--pen,#9f2f2d)}.ds-err{display:flex;align-items:center;gap:.5rem;margin:0;font-size:.875rem;color:var(--pen,#9f2f2d)}"
    },
    {
      "name": "Tick One",
      "kind": "custom",
      "refersTo": "tick-option-box",
      "description": "Single choice: a ruled square that receives a drawn red-pen tick.",
      "html": "<label class=\"ds-tick\"><input type=\"radio\" name=\"ds-acc\" checked><span class=\"ds-box\"><svg width=\"22\" height=\"18\" viewBox=\"0 0 22 18\" fill=\"none\" aria-hidden=\"true\"><path d=\"M2 10 L8 15 L20 3\" stroke=\"#9f2f2d\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" pathLength=\"1\" stroke-dasharray=\"1\"/></svg></span><span><b>Exact</b><small>From a certificate or hospital record</small></span></label><label class=\"ds-tick\"><input type=\"radio\" name=\"ds-acc\"><span class=\"ds-box\"><svg width=\"22\" height=\"18\" viewBox=\"0 0 22 18\" fill=\"none\" aria-hidden=\"true\"><path d=\"M2 10 L8 15 L20 3\" stroke=\"#9f2f2d\" stroke-width=\"2.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" pathLength=\"1\" stroke-dasharray=\"1\"/></svg></span><span><b>Don't know</b><small>Read from the Moon sign</small></span></label>",
      "css": ".ds-tick{display:flex;align-items:flex-start;gap:.75rem;min-height:4rem;padding:.25rem 0;cursor:pointer;font-family:var(--font-sans,Geist,sans-serif)}.ds-tick input{position:absolute;opacity:0;width:1px;height:1px}.ds-box{position:relative;margin-top:.125rem;width:24px;height:24px;flex-shrink:0;border:1px solid var(--ink-2,#2f3437);border-radius:3px;background:var(--paper,#fff);transition:border-color 200ms}.ds-tick:hover .ds-box{border-color:var(--ink,#111111)}.ds-box svg{position:absolute;top:-4px;left:2px}.ds-box path{stroke-dashoffset:1;transition:stroke-dashoffset 300ms ease-out}.ds-tick input:checked+.ds-box path{stroke-dashoffset:0}.ds-tick input:focus-visible+.ds-box{outline:2px solid var(--ink,#111111);outline-offset:2px}.ds-tick b{display:block;font-weight:500;color:var(--ink,#111111)}.ds-tick small{display:block;font-size:.875rem;color:var(--muted,#6b6a66)}"
    },
    {
      "name": "Status Pills",
      "kind": "chip",
      "refersTo": "pill-exalted",
      "description": "Dignity labels: pastel tint with matching deep text, uppercase.",
      "html": "<span class=\"ds-pill ds-green\">exalted</span> <span class=\"ds-pill ds-blue\">own</span> <span class=\"ds-pill ds-red\">debilitated</span>",
      "css": ".ds-pill{display:inline-block;border-radius:9999px;padding:.1rem .5rem;font:600 .68rem var(--font-sans,Geist,sans-serif);letter-spacing:.05em;text-transform:uppercase;white-space:nowrap}.ds-green{background:var(--green-bg,#edf3ec);color:var(--green,#346538)}.ds-blue{background:var(--blue-bg,#e1f3fe);color:var(--blue,#1f6c9f)}.ds-red{background:var(--pen-bg,#fdebec);color:var(--pen,#9f2f2d)}"
    },
    {
      "name": "Sheet Header and Steps",
      "kind": "nav",
      "refersTo": "button-compact",
      "description": "Slim sticky header on 90% bone with blur, plain-text wordmark, compact action; step progress with a pen underline on the current step.",
      "html": "<header class=\"ds-head\"><a class=\"ds-mark\" href=\"#\">Vedic Astro</a><button class=\"ds-hbtn\">Calculate my chart</button></header><ol class=\"ds-steps\"><li><i>1</i> Details</li><li class=\"ds-now\" aria-current=\"step\"><i>2</i> <u>Check</u></li><li><i>3</i> Chart</li></ol>",
      "css": ".ds-head{display:flex;align-items:center;justify-content:space-between;padding:.75rem 1.5rem;background:rgba(247,246,243,.9);backdrop-filter:blur(8px);border-bottom:1px solid var(--rule,#eaeaea);font-family:var(--font-sans,Geist,sans-serif)}.ds-mark{font-weight:600;letter-spacing:-.025em;color:var(--ink,#111111);text-decoration:none}.ds-mark:focus-visible{outline:2px solid var(--ink,#111111);outline-offset:3px;border-radius:4px}.ds-hbtn{border:0;border-radius:6px;background:var(--ink,#111111);color:#fff;padding:.5rem 1rem;font-family:inherit;font-weight:500;font-size:.875rem;cursor:pointer;transition:background-color 200ms}.ds-hbtn:hover{background:#333}.ds-hbtn:focus-visible{outline:2px solid var(--ink,#111111);outline-offset:3px}.ds-steps{display:flex;gap:1.5rem;list-style:none;padding:1rem 1.5rem;margin:0;font:.875rem var(--font-sans,Geist,sans-serif);color:var(--muted,#6b6a66)}.ds-steps i{font-style:normal;font-family:var(--font-mono,'Geist Mono',monospace);font-size:.75rem}.ds-now{color:var(--ink,#111111)}.ds-now u{text-decoration-color:var(--pen,#9f2f2d);text-decoration-thickness:2px;text-underline-offset:6px}"
    },
    {
      "name": "Worked Answer",
      "kind": "custom",
      "refersTo": "answer-line",
      "description": "Signature block: ruled working with mono steps, muted labels, a drawn tick, a red strike, and the margin question number.",
      "html": "<div class=\"ds-sheet\"><span class=\"ds-margin\"></span><span class=\"ds-qn\">Q1.</span><div class=\"ds-work\"><span class=\"ds-n\">(1)</span><span class=\"ds-l\">Time</span><span class=\"ds-mono\">07:45 IST − 05:30 = 02:15 UTC</span><span class=\"ds-n\">(3)</span><span class=\"ds-l\">Rule</span><span>Venus in Pisces is <span class=\"ds-pill2\">exalted</span> ⇒ rule matched <svg width=\"22\" height=\"18\" viewBox=\"0 0 22 18\" fill=\"none\" aria-hidden=\"true\"><path d=\"M2 10 L8 15 L20 3\" stroke=\"#9f2f2d\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" pathLength=\"1\" /></svg></span><span class=\"ds-n\">(4)</span><span class=\"ds-l\">Lagna</span><span><span class=\"ds-struck\">Lagna = ?</span> ⇒ Moon sign</span></div><p class=\"ds-note\">Partial data, honest answer.</p></div>",
      "css": ".ds-sheet{position:relative;padding:1rem 1rem 1rem 6rem;background-color:var(--bone,#f7f6f3);background-image:linear-gradient(to bottom,transparent calc(2rem - 1px),var(--ruling,#ebe9e3) calc(2rem - 1px));background-size:100% 2rem;line-height:2rem;font-family:var(--font-sans,Geist,sans-serif);color:var(--ink,#111111);font-variant-numeric:tabular-nums}.ds-margin{position:absolute;top:0;bottom:0;left:4.5rem;width:1px;background:rgba(159,47,45,.3)}.ds-qn{position:absolute;left:.5rem;width:3.25rem;text-align:right;font-family:var(--font-hand,Kalam,cursive);color:var(--pen,#9f2f2d);font-size:1.25rem}.ds-work{display:grid;grid-template-columns:2.25rem 5.75rem 1fr}.ds-work svg{vertical-align:-.2em}.ds-n{font-family:var(--font-mono,'Geist Mono',monospace);font-size:.75rem;color:var(--muted,#6b6a66)}.ds-l{font-size:.875rem;color:var(--muted,#6b6a66)}.ds-mono{font-family:var(--font-mono,'Geist Mono',monospace);font-size:.95rem}.ds-pill2{border-radius:9999px;padding:.1rem .5rem;font-size:.68rem;font-weight:600;letter-spacing:.05em;text-transform:uppercase;background:var(--green-bg,#edf3ec);color:var(--green,#346538)}.ds-struck{position:relative;color:var(--muted,#6b6a66)}.ds-struck::after{content:'';position:absolute;left:-2px;top:50%;height:2px;width:calc(100% + 4px);background:rgba(159,47,45,.8);transform:rotate(-2deg)}.ds-note{margin:0 0 0 8rem;font-family:var(--font-hand,Kalam,cursive);color:var(--pen,#9f2f2d);font-size:1.125rem}"
    },
    {
      "name": "Place Listbox",
      "kind": "custom",
      "refersTo": "place-listbox",
      "description": "The one floating slip: paper, hairline, 8px radius, the only shadow in the system.",
      "html": "<ul class=\"ds-list\" role=\"listbox\" aria-label=\"Places\"><li class=\"ds-opt ds-act\" role=\"option\" aria-selected=\"true\"><span>Pune, Maharashtra, India</span><small>Asia/Kolkata</small></li><li class=\"ds-opt\" role=\"option\" aria-selected=\"false\"><span>Punalur, Kerala, India</span><small>Asia/Kolkata</small></li></ul>",
      "css": ".ds-list{list-style:none;margin:0;padding:.25rem 0;max-width:28rem;background:var(--paper,#fff);border:1px solid var(--rule,#eaeaea);border-radius:8px;box-shadow:0 18px 40px -18px rgba(17,17,17,.18);font-family:var(--font-sans,Geist,sans-serif)}.ds-opt{display:flex;align-items:baseline;justify-content:space-between;gap:1rem;padding:.625rem .75rem;cursor:pointer;color:var(--ink,#111111)}.ds-opt:hover,.ds-act{background:var(--bone,#f7f6f3)}.ds-opt small{font-family:var(--font-mono,'Geist Mono',monospace);font-size:.75rem;color:var(--muted,#6b6a66)}"
    }
  ],
  "narrative": {
    "northStar": "The Worked Answer Sheet",
    "overview": "Every screen is a page of a ruled exam paper on which the chart is solved in front of the reader. The sheet is warm bone, ruled at a fixed pitch, with one pale red margin rule down the left. Questions are set in a tall editorial serif; the working beneath them is printed in a plain grotesque and a monospace for arithmetic and positions. A teacher's red pen marks the paper: question numbers in the margin, ticks against correct steps, short notes, a crossed-out unknown. Nothing on the sheet is boxed for decoration; the ruling and the margin are the structure.\n\nThe world is light-only (`color-scheme: light`); there is no dark theme. Density is that of a well-kept exam script: generous vertical space between questions, tight rhythm within an answer, every answer line snapped to the 2rem ruling. Colour is almost entirely monochrome; red pen is the only voice that marks, and pastel status tints only label dignities.\n\nMotion is handwriting. Lines are revealed left to right as if written, ticks are drawn as strokes, later answers write themselves in at the reader's scroll pace, and the unknown is struck through. With reduced motion requested, the whole page is static and complete.",
    "keyCharacteristics": [
      "Ruled bone sheet at a 2rem pitch with a single pale-red margin rule.",
      "Instrument Serif questions, Geist working, Geist Mono arithmetic, Kalam red pen for marking only.",
      "Question numbers live in the margin, outside the text column.",
      "Answers sit on lines, never in cards; inputs are underlines, not boxes.",
      "Red-pen SVG ticks, crosses and strikes are the only ornaments.",
      "Motion writes, draws and strikes; it never bounces or floats."
    ],
    "rules": [
      {
        "name": "The Red Pen Rule",
        "body": "Red marks the paper; it never prints on it. Pen colour is used for marks, notes, errors and the margin rule, never for body copy, buttons or fills.",
        "section": "colors"
      },
      {
        "name": "The Status-Only Pastels Rule",
        "body": "Green, blue and amber appear only as dignity and planet-state labels. They never decorate, illustrate or theme a section.",
        "section": "colors"
      },
      {
        "name": "The Marking Hand Rule",
        "body": "Kalam is for question numbers, ticks, short notes and marker labels (\"Note\", \"Marked\", \"Ans.\"). When a note grows into a sentence that must be read, the label stays in pen and the sentence is printed in Geist beside it.",
        "section": "typography"
      },
      {
        "name": "The Serif Asks Rule",
        "body": "Instrument Serif is reserved for questions and step titles. Answers are never set in the serif.",
        "section": "typography"
      },
      {
        "name": "The On-The-Line Rule",
        "body": "Answer text, table rows and working rows take `line-height: var(--line)` or `height: var(--line)`. If it is an answer, it sits on a rule.",
        "section": "layout"
      },
      {
        "name": "The Flat Sheet Rule",
        "body": "Nothing on the sheet casts a shadow except a floating slip that sits above it.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** set every answer, working row and table row on the 2rem ruling pitch.",
      "**Do** put question numbers in Kalam red pen in the margin, outside the text column.",
      "**Do** mark correct steps with the drawn red-pen tick SVG and unknowns with the red strike line.",
      "**Do** use Geist Mono for any time, offset, degree, coordinate or step number.",
      "**Do** gloss Jyotish terms with Tiro Devanagari Sanskrit in muted at 0.9em.",
      "**Do** register every animation under `(prefers-reduced-motion: no-preference)` and make the reduced-motion page complete.",
      "**Do** use the answer-line underline for text inputs and the ruled tick box for single choices."
    ],
    "donts": [
      "**Don't** set body copy or long sentences in Kalam; pen notes stay short, and readable content is printed in Geist.",
      "**Don't** use pen red for buttons, fills, links or headings.",
      "**Don't** box the working in cards or bordered panels; boxes are kept for floating slips and the raw-data block.",
      "**Don't** add shadows to anything resting on the sheet.",
      "**Don't** use green, blue or amber outside status labels.",
      "**Don't** add a dark theme; the paper is light-only.",
      "**Don't** introduce a second button style; secondary actions are underlined links."
    ]
  }
}
