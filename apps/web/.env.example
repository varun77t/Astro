# Copy to .env.local and fill in. These values are public by design (they end up in the
# browser); row-level security in the database is what protects each user's data.

# Supabase project (accounts and saved charts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Only if the API isn't on http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000
